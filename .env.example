BOT_TOKEN=your_telegram_bot_token_here
WEBAPP_URL=https://your-tunnel.trycloudflare.com
DATABASE_PATH=goodbingo.db
SERVER_PORT=8765

# Telebirr H5 checkout (testbed by default)
TELEBIRR_BASE_URL=https://196.188.120.3:38443/apiaccess/payment/gateway
TELEBIRR_FABRIC_APP_ID=your_fabric_app_id
TELEBIRR_APP_SECRET=your_app_secret
TELEBIRR_MERCHANT_APP_ID=your_merchant_app_id
TELEBIRR_MERCHANT_CODE=your_shortcode
TELEBIRR_WEB_BASE_URL=https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?
TELEBIRR_PRIVATE_KEY=your_rsa_private_key_base64
# Optional: Telebirr's RSA public key. When set, /telebirr/notify verifies the
# callback signature and rejects invalid ones. Leave empty to skip (dev mode).
TELEBIRR_PUBLIC_KEY=

# PeerPay payment webhooks (https://peerpayment.org/docs/webhooks)
# 1. In PeerPay Developer Controls → Webhook Endpoints, register a public HTTPS
#    URL: https://<your-host>/peerpay/webhook (keep the default deposit +
#    withdrawal events).
# 2. Copy the signing secret PeerPay shows once on create/rotate.
# 3. PeerPay sends a signed webhook.test; the endpoint becomes active after it
#    returns 2xx.
PEERPAY_API_KEY=your_peerpay_api_key
PEERPAY_BASE_URL=https://api.peerpayment.org
# Required for production. When set, /peerpay/webhook verifies the
# PeerPay-Signature (HMAC-SHA256 over "<eventId>.<timestamp>.<raw body>",
# header "v2=<hex>"). Empty = dev mode (no check).
PEERPAY_WEBHOOK_SECRET=
